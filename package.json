    "test:all": "npm run test:catalog && npm run test:address",
    "address:diagnose": "node scripts/diagnose-address.mjs"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-sqlite": "~58.0.17",
    "expo-linear-gradient": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "@expo/vector-icons": "^15.0.3"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/react": "~19.2.0"
  }
}
